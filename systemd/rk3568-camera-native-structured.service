[Unit]
Description=RK3568 native OCR structured-field worker
After=local-fs.target
Before=rk3568-camera-native-pipeline.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/rk3568_camera/report_parser
Environment=PYTHONPATH=/opt/rk3568_camera/report_parser/src
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/var/lib/rk3568-camera/native.env
ExecStart=/opt/rk3568_camera/.venv-camera/bin/python /opt/rk3568_camera/report_parser/scripts/native_structured_worker.py --socket ${STRUCTURED_SOCKET} --input ${NATIVE_OCR_FILE} --schema /var/lib/rk3568-camera/active-field-rules.json --schema-endpoint ${FIELD_RULES_ENDPOINT} --full-text-output /run/rk3568-camera/verified-full-text.json --structured-output /run/rk3568-camera/structured-result.json --status-output /run/rk3568-camera/structured-status.json
Restart=on-failure
RestartSec=1
RuntimeDirectory=rk3568-camera
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/rk3568-camera

[Install]
WantedBy=multi-user.target
